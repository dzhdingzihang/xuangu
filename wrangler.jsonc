{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xuangu",
  "main": "./src/index.js",
  "compatibility_date": "2026-05-29",
  "workers_dev": false,
  "vars": {
    "CLOUDFLARE_SCHEDULER_ENABLED": "1"
  },
  "triggers": {
    "crons": [
      "17 0,2,4,7,8,12 * * MON-FRI",
      "47 14 * * MON-FRI",
      "17 20 * * MON-FRI",
      "17 21 * * MON-FRI"
    ]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ratelimits": [
    {
      "name": "LIVE_RATE_LIMITER",
      "namespace_id": "73142201",
      "simple": {
        "limit": 90,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "pattern": "xuangu.alixjd.com/*",
      "zone_name": "alixjd.com"
    }
  ]
}
